# Genera .env con: node scripts/init-env.mjs
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATA_ENCRYPTION_KEY=
# Chiave separata per le password transitorie di migrazione (solo backend).
MIGRATION_ENCRYPTION_KEY=
ONBOARDING_PASSWORD_TTL_SECONDS=86400
OIDC_IDENTITY_ADMIN_SECRET=
# Admin applicativo: login Connect, realm eulab
EULAB_ADMIN_USERNAME=admin
EULAB_ADMIN_EMAIL=admin@eulab.local
EULAB_ADMIN_NAME=Amministratore EULab
EULAB_ADMIN_PASSWORD=
OIDC_CLIENT_SECRET=
# Console di gestione Keycloak: realm master
KEYCLOAK_ADMIN=eulab-operator
KEYCLOAK_ADMIN_PASSWORD=
PUBLIC_KEYCLOAK_URL=http://localhost:8080
PUBLIC_OIDC_ISSUER=http://localhost:8080/realms/eulab
RUNNER_CAPACITY=2
# Per lo sviluppo senza Compose:
# DATABASE_URL=postgres://...
# REDIS_URL=redis://...
# OIDC_INTERNAL_ISSUER=http://localhost:8080/realms/eulab
# OIDC_JWKS_URL=http://localhost:8080/realms/eulab/protocol/openid-connect/certs

# Optional explicit local-only catalog routing; never accepted from API payloads.
# CATALOG_INTERNAL_ORIGINS_JSON={"http://localhost:8090":"http://qa-wordpress"}

# SMTP condiviso da API e Keycloak (sincronizzare da Sicurezza / SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
