{
  "name": "eulab-connect",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --config apps/web/vite.config.ts",
    "dev:api": "tsc -p apps/api/tsconfig.json && node --env-file=.env --watch dist/server/apps/api/src/main.js",
    "dev:runner": "tsc -p apps/api/tsconfig.json && node --env-file=.env dist/server/apps/runner/src/main.js",
    "dev:demo": "vite --host 127.0.0.1 --config apps/demo/vite.config.ts",
    "build": "tsc -p apps/api/tsconfig.json && tsc -p packages/sdk/tsconfig.json && tsc -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts && vite build --config apps/demo/vite.config.ts && node scripts/build-wordpress-installer.mjs",
    "test": "tsc -p apps/api/tsconfig.json && tsc -p packages/sdk/tsconfig.json && node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "db:migrate": "node --env-file=.env --import tsx apps/api/src/migrate.ts",
    "infra:up": "docker compose up -d --build",
    "infra:check": "docker compose config --quiet",
    "verify": "npm test && npm run build && npm run infra:check",
    "test:http": "tsc -p apps/api/tsconfig.json && node --test tests/http.test.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "brand:sync": "node scripts/sync-brand.mjs",
    "prebuild": "npm run brand:sync",
    "predev": "npm run brand:sync",
    "test:mfa:core": "node scripts/test-mfa-core.mjs",
    "env:check": "node scripts/check-environments.mjs",
    "infra:check:prod": "docker compose -f compose.yaml -f infra/compose.production.yaml --env-file .env.production config --quiet",
    "security:prepare": "node scripts/setup-security.mjs",
    "security:activate": "node scripts/setup-security.mjs --activate",
    "smtp:check": "node --env-file=.env scripts/check-smtp.mjs",
    "smtp:sync": "node --env-file=.env scripts/check-smtp.mjs --sync",
    "security:profile": "node scripts/setup-security-profile.mjs",
    "deploy:production": "node scripts/deploy-production.mjs",
    "verify:whatsapp": "node scripts/verify-whatsapp-ui.mjs",
    "package:production": "node scripts/package-production.mjs",
    "package:npm": "node scripts/package-npm.mjs",
    "verify:npm": "node scripts/verify-npm.mjs",
    "verify:startup": "node scripts/verify-compose-startup.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "build:runtime": "tsc -p apps/api/tsconfig.json && node scripts/build-runtime.mjs",
    "verify:images": "node scripts/verify-runtime-images.mjs",
    "package:sdk": "node scripts/package-sdk.mjs",
    "test:sdk:real": "tsc -p apps/api/tsconfig.json && node scripts/check-sdk-real-provider.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.2.6",
    "bullmq": "5.81.4",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "nodemailer": "9.0.3",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.22.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@nestjs/testing": "11.1.28",
    "@playwright/test": "1.57.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "light-my-request": "6.6.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "esbuild": "0.28.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "rollup": "4.62.4",
    "@ioredis/commands": "1.10.0",
    "undici-types": "6.21.0",
    "swagger-ui-dist": "5.31.0",
    "@nestjs/mapped-types": "2.1.0"
  }
}
